Checks: 'concurrency-*,portability-*,performance-*,bugprone-*,google-*,clang-analyzer-*,readability-*,modernize-*,-modernize-use-trailing-*,-readability-redundant-access-specifiers'
HeaderFilterRegex: '^(?!.*(butil|fmt|liburing)/*.h).*$'
CheckOptions:
  - key:             readability-identifier-length.MinimumVariableNameLength
    value:           2
  - key:             readability-identifier-naming.ParameterCase
    value:           lower_case
  - key:             readability-identifier-naming.LocalVariableCase
    value:           lower_case
  - key:             readability-identifier-naming.ClassMemberCase
    value:           lower_case
  - key:             readability-identifier-naming.GlobalConstantCase
    value:           k
  - key:             readability-identifier-naming.ClassMemberSuffix
    value:           _
  - key:             readability-identifier-naming.ConstantMemberCase
    value:           k
  - key:             readability-identifier-naming.StaticConstantCase
    value:           k
  - key:             readability-identifier-naming.FunctionCase
    value:           CamelCase
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
  - key:             readability-identifier-naming.EnumCasePrefix
    value:           k
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.AbstractClassPrefix
    value:           Abstract